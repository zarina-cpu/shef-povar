# Google AI — рецепты (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Auth.js на Vercel (https://authjs.dev)
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=
# Локально: http://localhost:3000  |  Production: https://ваш-домен.vercel.app
AUTH_URL=http://localhost:3000

# Google OAuth — Google Cloud Console → Credentials → OAuth client (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Turso — https://turso.tech (Database URL + token)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# После создания базы выполните: turso db shell <your-db> < turso/schema.sql
# В Vercel: Project → Settings → Environment Variables (те же ключи)
